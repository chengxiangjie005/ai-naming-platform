# SUPABASE（Supabase → Project Settings → API）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# 火山方舟（豆包）https://console.volcengine.com/ark
DOUBAO_API_KEY=ark-xxxxxxxx
# 方舟的模型名（推理接入点 ID 形如 ep-xxxx，或模型名 doubao-seed-1-6-250615）
DOUBAO_MODEL=doubao-seed-1-6-250615

# DeepSeek https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 通义千问 DashScope https://bailian.console.aliyun.com
QWEN_API_KEY=sk-xxxxxxxx

# Kimi https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=sk-xxxxxxxx

# 免密钥公共测试模型（可选，正式上线建议删除此配置）
# FREE_BASE_URL=https://text.pollinations.ai/openai
# FREE_MODEL=openai

# OpenRouter（强烈建议用这个，有免费额度，无需实名）
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
